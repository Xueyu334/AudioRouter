<Window x:Class="AudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="音频转发器"
        Icon="/Assets/voice.ico"
        Width="1100"
        Height="800"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FB" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppSecondarySurfaceBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#E5EAF2" />
        <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AppBrandBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AppBrandHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AppBrandTintBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="AppHealthyBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="AppHealthyTintBrush" Color="#ECFDF3" />
        <SolidColorBrush x:Key="AppWarningBrush" Color="#D97706" />
        <SolidColorBrush x:Key="AppWarningTintBrush" Color="#FFF7ED" />
        <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="AppStoppedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AppStoppedTintBrush" Color="#F1F5F9" />

        <DropShadowEffect x:Key="SurfaceShadow"
                          BlurRadius="18"
                          Direction="270"
                          Opacity="0.09"
                          ShadowDepth="3"
                          Color="#334155" />

        <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButtonStyle"
               BasedOn="{StaticResource ActionButtonBaseStyle}"
               TargetType="Button">
            <Setter Property="Width" Value="156" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AppBrandBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrandBrush}" />
            <Setter Property="Command" Value="{Binding StartCommand}" />
            <Setter Property="Content" Value="▶  开始转发" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForwarding}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                    <Setter Property="Command" Value="{Binding StopCommand}" />
                    <Setter Property="Content" Value="■  停止转发" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppWarningBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
                    <Setter Property="Command" Value="{Binding StopCommand}" />
                    <Setter Property="Content" Value="■  停止恢复" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RefreshButtonStyle"
               BasedOn="{StaticResource ActionButtonBaseStyle}"
               TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppBrandBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppBrandTintBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="RaisedSurfaceCardStyle"
               BasedOn="{StaticResource SurfaceCardStyle}"
               TargetType="Border">
            <Setter Property="Effect" Value="{StaticResource SurfaceShadow}" />
        </Style>

        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppSecondarySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="ProcessingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AppBrandTintBrush}" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{DynamicResource AppSecondarySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>

        <Style x:Key="AdvancedMetricCardStyle"
               BasedOn="{StaticResource MetricCardStyle}"
               TargetType="Border">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource AppStoppedTintBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForwarding}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppHealthyTintBrush}" />
                    <Setter Property="BorderBrush" Value="#BBF7D0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppWarningTintBrush}" />
                    <Setter Property="BorderBrush" Value="#FED7AA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource AppStoppedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForwarding}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AppHealthyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForwarding}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppHealthyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="选择监听和输出设备后即可开始转发" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForwarding}" Value="True">
                    <Setter Property="Text" Value="音频正在通过当前链路实时传输" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Text" Value="设备连接中断，正在等待自动恢复" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIconSurfaceStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource AppStoppedTintBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForwarding}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppHealthyTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppWarningTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <!-- 顶部紧凑应用栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            Margin="0,0,11,0"
                            Background="{DynamicResource AppBrandBrush}"
                            CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="♪" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}"
                                   Text="音频转发器" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Text="低延迟设备音频路由" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Margin="0,0,8,0"
                            Style="{StaticResource StatusPillStyle}">
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Margin="0,0,7,0"
                                     Style="{StaticResource StatusDotStyle}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Style="{StaticResource StatusTextStyle}"
                                       Text="{Binding StatusText}" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RefreshDevicesCommand}"
                            Content="↻  刷新设备"
                            Style="{StaticResource RefreshButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部音频链路与性能区域 -->
        <ScrollViewer Grid.Row="1"
                      CanContentScroll="False"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      VerticalScrollBarVisibility="Hidden">
            <Grid Margin="22,16,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 音频链路 -->
                <Border Grid.Row="0"
                        Padding="18"
                        Style="{StaticResource RaisedSurfaceCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="音频链路" />
                                <TextBlock Style="{StaticResource SectionHintStyle}"
                                           Text="从系统播放设备捕获声音，经过低延迟处理后发送到目标设备" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="10,5"
                                    Background="{DynamicResource AppBrandTintBrush}"
                                    CornerRadius="12">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppBrandBrush}"
                                           Text="WASAPI LOOPBACK" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 监听设备 -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource DeviceCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AppBrandTintBrush}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Path Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M2,8 L6,8 L11,4 L11,20 L6,16 L2,16 Z"
                                                      Fill="{DynamicResource AppBrandBrush}"
                                                      Stretch="Uniform" />
                                                <Path Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M13,8 C15,10 15,14 13,16 M16,5 C20,9 20,15 16,19"
                                                      Stroke="{DynamicResource AppBrandBrush}"
                                                      StrokeEndLineCap="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.8"
                                                      Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                                       Text="声音来源" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="监听播放设备" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,12,0,7"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="捕获此设备当前播放的系统声音" />
                                    <hc:ComboBox Height="44"
                                                 Padding="12,0"
                                                 DisplayMemberPath="Name"
                                                 FontSize="13"
                                                 IsEnabled="{Binding IsConfigurationEnabled}"
                                                 ItemsSource="{Binding Devices}"
                                                 MaxDropDownHeight="280"
                                                 SelectedItem="{Binding SelectedListeningDevice}"
                                                 ToolTip="{Binding SelectedListeningDevice.Name}" />
                                    <StackPanel Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource AppHealthyBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedListeningDevice}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecovering}"
                                                                     Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppHealthyBrush}" />
                                                    <Setter Property="Text"
                                                            Value="设备可用 · Loopback 捕获" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedListeningDevice}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                            <Setter Property="Text"
                                                                    Value="请选择监听设备" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecovering}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                            <Setter Property="Text"
                                                                    Value="等待监听设备恢复" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 输入到处理的流向 -->
                            <Grid Grid.Column="1"
                                  Margin="10,0"
                                  VerticalAlignment="Center">
                                <Rectangle Height="2"
                                           Margin="0,0,6,0"
                                           Fill="#BFDBFE" />
                                <Path Width="7"
                                      Height="11"
                                      HorizontalAlignment="Right"
                                      Data="M0,0 L7,5.5 L0,11 Z"
                                      Fill="#60A5FA"
                                      Stretch="Fill" />
                            </Grid>

                            <!-- 音频处理 -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource ProcessingCardStyle}">
                                <StackPanel>
                                    <StackPanel HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsForwarding}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRecovering}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="0.65" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="4"
                                                Height="12"
                                                Margin="2,0"
                                                VerticalAlignment="Bottom"
                                                Background="#93C5FD"
                                                CornerRadius="2" />
                                        <Border Width="4"
                                                Height="21"
                                                Margin="2,0"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource AppBrandBrush}"
                                                CornerRadius="2" />
                                        <Border Width="4"
                                                Height="28"
                                                Margin="2,0"
                                                VerticalAlignment="Bottom"
                                                Background="#60A5FA"
                                                CornerRadius="2" />
                                        <Border Width="4"
                                                Height="17"
                                                Margin="2,0"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource AppBrandBrush}"
                                                CornerRadius="2" />
                                        <Border Width="4"
                                                Height="24"
                                                Margin="2,0"
                                                VerticalAlignment="Bottom"
                                                Background="#93C5FD"
                                                CornerRadius="2" />
                                    </StackPanel>
                                    <TextBlock Margin="0,9,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource CardTitleStyle}"
                                               Text="音频处理" />
                                    <TextBlock Margin="0,2,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="共享模式 · 低延迟链路" />

                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   Text="目标延迟" />
                                        <hc:ComboBox Grid.Column="1"
                                                     Height="38"
                                                     Padding="10,0"
                                                     IsEnabled="{Binding IsConfigurationEnabled}"
                                                     ItemsSource="{Binding LatencyOptions}"
                                                     SelectedItem="{Binding SelectedLatency}">
                                            <hc:ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0} ms}" />
                                                </DataTemplate>
                                            </hc:ComboBox.ItemTemplate>
                                        </hc:ComboBox>
                                    </Grid>

                                    <StackPanel Margin="0,11,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Ellipse Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource StatusDotStyle}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Style="{StaticResource StatusTextStyle}"
                                                   Text="{Binding StatusText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 处理到输出的流向 -->
                            <Grid Grid.Column="3"
                                  Margin="10,0"
                                  VerticalAlignment="Center">
                                <Rectangle Height="2"
                                           Margin="0,0,6,0"
                                           Fill="#BFDBFE" />
                                <Path Width="7"
                                      Height="11"
                                      HorizontalAlignment="Right"
                                      Data="M0,0 L7,5.5 L0,11 Z"
                                      Fill="#60A5FA"
                                      Stretch="Fill" />
                            </Grid>

                            <!-- 输出设备 -->
                            <Border Grid.Column="4"
                                    Style="{StaticResource DeviceCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource AppBrandTintBrush}"
                                                CornerRadius="8">
                                            <Path Width="18"
                                                  Height="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M4,12 A8,8 0 0 1 20,12 M4,12 L4,18 Q4,20 6,20 L8,20 L8,13 L5,13 M20,12 L20,18 Q20,20 18,20 L16,20 L16,13 L19,13"
                                                  Stroke="{DynamicResource AppBrandBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="2"
                                                  Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                                       Text="输出设备" />
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       Text="转发播放目标" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,12,0,7"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="将捕获的声音实时发送到此设备" />
                                    <hc:ComboBox Height="44"
                                                 Padding="12,0"
                                                 DisplayMemberPath="Name"
                                                 FontSize="13"
                                                 IsEnabled="{Binding IsConfigurationEnabled}"
                                                 ItemsSource="{Binding Devices}"
                                                 MaxDropDownHeight="280"
                                                 SelectedItem="{Binding SelectedOutputDevice}"
                                                 ToolTip="{Binding SelectedOutputDevice.Name}" />
                                    <StackPanel Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource AppHealthyBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOutputDevice}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecovering}"
                                                                     Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppHealthyBrush}" />
                                                    <Setter Property="Text"
                                                            Value="设备可用 · WASAPI 输出" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOutputDevice}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                            <Setter Property="Text"
                                                                    Value="请选择输出设备" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecovering}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppWarningBrush}" />
                                                            <Setter Property="Text"
                                                                    Value="等待输出设备恢复" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 普通模式性能摘要 -->
                <Border Grid.Row="2"
                        Padding="14"
                        Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <Grid Margin="4,0,4,7">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="实时状态" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SectionHintStyle}"
                                       Text="核心指标" />
                        </Grid>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="估算延迟" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding EstimatedLatencyText}"
                                               ToolTip="{Binding EstimatedLatencyText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="当前 / 峰值缓冲" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding BufferStatusText}"
                                               ToolTip="{Binding BufferStatusText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="输出状态" />
                                    <TextBlock Text="{Binding StatusText}"
                                               ToolTip="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource MetricValueStyle}"
                                                   TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AppStoppedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsForwarding}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppHealthyBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRecovering}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppWarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="运行时间" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding ForwardingDurationText}"
                                               ToolTip="{Binding ForwardingDurationText}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 默认折叠的高级性能数据 -->
                <Border Grid.Row="4"
                        Padding="14,6"
                        Style="{StaticResource SurfaceCardStyle}">
                    <Expander IsExpanded="False"
                              Style="{StaticResource Expander.Small}">
                        <Expander.Header>
                            <StackPanel Margin="2,2,0,2"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}"
                                           Text="高级性能数据" />
                                <Border Margin="9,0,0,0"
                                        Padding="8,3"
                                        Background="{DynamicResource AppStoppedTintBrush}"
                                        CornerRadius="10">
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                               Text="详细诊断" />
                                </Border>
                            </StackPanel>
                        </Expander.Header>

                        <UniformGrid Margin="0,10,0,4"
                                     Columns="3">
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="配置档位" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding TargetLatencyText}"
                                               ToolTip="{Binding TargetLatencyText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="活动管线 / 请求周期" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding PipelineStatusText}"
                                               ToolTip="{Binding PipelineStatusText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="捕获速率" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding CaptureRateText}"
                                               ToolTip="{Binding CaptureRateText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="有效输出 / 累计补零" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding OutputRateText}"
                                               ToolTip="{Binding OutputRateText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="捕获回调 / 最大间隔" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding CallbackRateText}"
                                               ToolTip="{Binding CallbackRateText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="欠载 / 重缓冲" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding RecoveryStatsText}"
                                               ToolTip="{Binding RecoveryStatsText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AdvancedMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricLabelStyle}"
                                               Text="时钟校正 / 丢弃" />
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Text="{Binding DriftStatusText}"
                                               ToolTip="{Binding DriftStatusText}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Expander>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 底部状态与单一控制区 -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Margin="0,0,11,0"
                            Style="{StaticResource StatusIconSurfaceStyle}">
                        <Ellipse HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource StatusDotStyle}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   Style="{StaticResource StatusTextStyle}"
                                   Text="{Binding StatusText}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource StatusDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource TransportButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
